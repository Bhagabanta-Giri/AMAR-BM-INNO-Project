<?xml version="1.0" ?>
<robot name="turtlebot3_burger_cam"
  xmlns:xacro="http://ros.org">
  
  <material name="black">
      <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.4235 0.0392 1.0"/>
  </material>

  <material name="brown">
    <color rgba="0.8706 0.8118 0.7647 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Z origin shifted up from 0.010 to 0.050 -->
    <origin xyz="0.0 0.0 0.050" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <!-- X position scaled from -0.032 to -0.160 -->
      <origin xyz="-0.160 0 0.0" rpy="0 0 0"/>
      <geometry>
        <!-- Mesh visual scale factor increased from 0.001 to 0.005 -->
        <mesh filename="file://$(find amar_description)/models/turtlebot3_common/meshes/bases/burger_base.stl" scale="0.005 0.005 0.005"/>
      </geometry>
      <material name="light_black"/>
    </visual>

    <collision>
      <!-- Collision origin box extents scaled 5x -->
      <origin xyz="-0.160 0 0.350" rpy="0 0 0"/>
      <geometry>
        <box size="0.700 0.700 0.715"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- Mass scaled realistically for stability (~15x) -->
      <mass value="12.38"/>
      <inertia ixx="3.31e-02" ixy="-1.84e-04" ixz="5.24e-04" iyy="3.17e-02" iyz="-7.51e-05" izz="3.00e-02" />
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <!-- Joint attachment coordinates scaled 5x -->
    <origin xyz="0.0 0.400 0.115" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="file://$(find amar_description)/models/turtlebot3_common/meshes/wheels/left_tire.stl" scale="0.005 0.005 0.005"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Cylinder metrics: length 0.09, radius 0.165 -->
        <cylinder length="0.090" radius="0.165"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.427" />
      <inertia ixx="1.67e-04" ixy="-6.35e-10" ixz="-8.90e-08" iyy="1.67e-04" iyz="-2.16e-10" izz="3.10e-04" />
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <!-- Joint attachment coordinates scaled 5x -->
    <origin xyz="0.0 -0.400 0.115" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="file://$(find amar_description)/models/turtlebot3_common/meshes/wheels/right_tire.stl" scale="0.005 0.005 0.005"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.090" radius="0.165"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.427" />
      <inertia ixx="1.67e-04" ixy="-6.35e-10" ixz="-8.90e-08" iyy="1.67e-04" iyz="-2.16e-10" izz="3.10e-04" />
    </inertial>
  </link>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_link"/>
    <!-- Coordinates scaled 5x -->
    <origin xyz="-0.405 0 -0.020" rpy="-1.57 0 0"/>
  </joint>

  <link name="caster_back_link">
    <collision>
      <origin xyz="0 0.005 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.150 0.045 0.100"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.075" />
      <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.015" />
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.160 0 0.340" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.160 0 0.860" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find amar_description)/models/turtlebot3_common/meshes/sensors/lds.stl" scale="0.005 0.005 0.005"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0.075 0 -0.0325" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.1575" radius="0.275"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.71" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.015" />
    </inertial>
  </link>
  
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.200 -0.000 0.550" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <link name="camera_link">
    <collision>
      <origin xyz="0.025 0.000 0.065" rpy="0 0 0"/>
      <geometry>
        <box size="0.075 0.150 0.135"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_rgb_joint" type="fixed">
    <origin xyz="0.015 0.000 0.045" rpy="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_rgb_frame"/>
  </joint>
  <link name="camera_rgb_frame"/>

  <joint name="camera_rgb_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707 0 -1.57"/>
    <parent link="camera_rgb_frame"/>
    <child link="camera_rgb_optical_frame"/>
  </joint>
  <link name="camera_rgb_optical_frame"/>

</robot>
