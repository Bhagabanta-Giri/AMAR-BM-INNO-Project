<?xml version="1.0" ?>
<robot name="turtlebot3_burger_cam"
  xmlns:xacro="http://ros.org">

  <material name="black">
      <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.4235 0.0392 1.0"/>
  </material>

  <material name="brown">
    <color rgba="0.8706 0.8118 0.7647 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.025" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-0.080 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find amar_description)/models/turtlebot3_common/meshes/bases/burger_base.stl" scale="0.0025 0.0025 0.0025"/>
      </geometry>
      <material name="light_black"/>
    </visual>

    <collision>
      <origin xyz="-0.080 0 0.175" rpy="0 0 0"/>
      <geometry>
        <box size="0.350 0.350 0.350"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.080 0 0.175" rpy="0 0 0"/>
      <mass value="12.9"/>
      <inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3" />
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.200 0.0575" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="file://$(find amar_description)/models/turtlebot3_common/meshes/wheels/left_tire.stl" scale="0.0025 0.0025 0.0025"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.045" radius="0.0825"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.445" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.200 0.0575" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="file://$(find amar_description)/models/turtlebot3_common/meshes/wheels/right_tire.stl" scale="0.0025 0.0025 0.0025"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.045" radius="0.0825"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.445" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_link"/>
    <origin xyz="-0.2025 0 -0.010" rpy="-1.57 0 0"/>
  </joint>

  <link name="caster_back_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0125"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.078125" />
      <inertia ixx="0.09765" ixy="0.0" ixz="0.0" iyy="0.09765" iyz="0.0" izz="0.09765" />
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.080 0 0.170" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.080 0 0.4275" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find amar_description)/models/turtlebot3_common/meshes/sensors/lds.stl" scale="0.0025 0.0025 0.0025"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0.030 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.1375" radius="0.1270"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.030 0 -0.025" />
      <mass value="1.78125" />
      <inertia ixx="0.09765" ixy="0.0" ixz="0.0" iyy="0.09765" iyz="0.0" izz="0.09765" />
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.100 0.000 0.275" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <link name="camera_link">
    <collision>
      <origin xyz="0.0125 0.000 0.0325" rpy="0 0 0"/>
      <geometry>
        <box size="0.0375 0.075 0.0675"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.090 0 -0.0425" />
      <mass value="0.546875" />
      <inertia ixx="0.09765" ixy="0.0" ixz="0.0" iyy="0.09765" iyz="0.0" izz="0.09765" />
    </inertial>
  </link>

  <joint name="camera_rgb_joint" type="fixed">
    <origin xyz="0.0075 0.000 0.0225" rpy="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_rgb_frame"/>
  </joint>
  <link name="camera_rgb_frame"/>

  <joint name="camera_rgb_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707 0 -1.57"/>
    <parent link="camera_rgb_frame"/>
    <child link="camera_rgb_optical_frame"/>
  </joint>
  <link name="camera_rgb_optical_frame"/>

</robot>